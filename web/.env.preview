# Environnement de prévisualisation
NODE_ENV=production

# Mode de build
VUE_APP_BUILD_MODE=PREVIEW
# Préfixe du titre de la page
VUE_APP_TITLE=Django Vue Admin
# Afficher le bouton code source
VUE_APP_SCOURCE_LINK=FALSE

# Chemin public
VUE_APP_PUBLIC_PATH=/
# Activer la gestion des permissions
VUE_APP_PM_ENABLED = true
# Moteur de stockage de fichiers
VUE_APP_FILE_ENGINE = 'local'  # oss, cos, local
